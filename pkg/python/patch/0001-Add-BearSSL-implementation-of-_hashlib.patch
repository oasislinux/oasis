+
+static PyObject *
+HASH_repr(HASH *self)
+{
+    PyObject *name = HASH_get_name(self, NULL);
+    if (name == NULL) {
+        return NULL;
+    }
+    PyObject *repr = PyUnicode_FromFormat("<%U %T object @ %p>",
+                                          name, self, self);
+    Py_DECREF(name);
+    return repr;
+}
+
+static PyTypeObject HASH_Type = {
