+    HASHLIB_INIT_MUTEX(newobj);
+    HASHLIB_ACQUIRE_LOCK(self);
+    newobj->ctx = self->ctx;
+    HASHLIB_RELEASE_LOCK(self);
+
+    return (PyObject *)newobj;
+}
+
+static PyMethodDef HASH_methods[] = {
+    HASH_UPDATE_METHODDEF
+    HASH_DIGEST_METHODDEF
+    HASH_HEXDIGEST_METHODDEF
