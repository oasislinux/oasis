+static PyObject *
+HASHXOF_new(PyObject *module, int bits, Py_buffer *data, int usedforsecurity)
+{
+    HASHXOF *self;
+
+    self = PyObject_New(HASHXOF, &HASHXOF_Type);
+    if (!self)
+        return NULL;
+    self->bits = bits;
+    br_shake_init(&self->ctx, bits);
+    HASHLIB_INIT_MUTEX(self);
+    HASHLIB_EXTERNAL_INSTRUCTIONS_UNLOCKED(
+        data->len,
+        br_shake_inject(&self->ctx, data->buf, data->len);
+    );
+
